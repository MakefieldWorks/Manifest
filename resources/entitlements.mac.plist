<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs to map JIT pages under the hardened runtime. Nothing else is
         granted: native modules (better-sqlite3) are signed with the same
         identity, so library validation stays on. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
